// Unit tests for the code layer (config.sla): deny rule, assets
// alias routing, and the ip.sla-backed ACL predicate.
// Run from the repo root:
//   sa test tests/config_test.sla

@import "src/config.sla"
@import "sa_std/string.sa"

@test "deny rule covers internal and its children only"() {
    if config_path_denied(STR_PTR("internal"), STR_LEN("internal")) { } else { panic(201); };
    if config_path_denied(STR_PTR("internal/secret.txt"), STR_LEN("internal/secret.txt")) { } else { panic(202); };
    if config_path_denied(STR_PTR("index.html"), STR_LEN("index.html")) { panic(203); };
    if config_path_denied(STR_PTR("internalized/x"), STR_LEN("internalized/x")) { panic(204); };
}

@test "assets route matches the alias prefix only"() {
    if config_route_is_assets(STR_PTR("assets"), STR_LEN("assets")) { } else { panic(211); };
    if config_route_is_assets(STR_PTR("assets/logo.txt"), STR_LEN("assets/logo.txt")) { } else { panic(212); };
    if config_route_is_assets(STR_PTR("assetsx/logo.txt"), STR_LEN("assetsx/logo.txt")) { panic(213); };
    if config_route_is_assets(STR_PTR("index.html"), STR_LEN("index.html")) { panic(214); };
}

@test "assets root is the code-layer constant"() {
    let r = config_assets_root();
    if r.len != 10 { panic(221); };
    if r.bytes[0] != 119 { panic(222); };
}

@test "acl refuses RFC1918 and unparseable input, allows public"() {
    if config_acl_allows(format("8.8.8.8")) { } else { panic(231); };
    if config_acl_allows(format("10.1.2.3")) { panic(232); };
    if config_acl_allows(format("172.16.5.4")) { panic(233); };
    if config_acl_allows(format("172.31.255.255")) { panic(234); };
    if config_acl_allows(format("172.32.0.1")) { } else { panic(235); };
    if config_acl_allows(format("192.168.1.1")) { panic(236); };
    if config_acl_allows(format("not-an-ip")) { panic(237); };
}

// Bytes-form ACL (the request path): same decisions as the
// String form, over raw peer bytes with caller-owned scratch.
@test "bytes acl matches the string acl on v4, v6 and junk"() {
    let oct = ipv4_octets_new();
    let endb = u64box_new();
    let pos = u64box_new();
    let v = u64box_new();
    if config_acl_allows_bytes(STR_PTR("8.8.8.8"), STR_LEN("8.8.8.8"), &oct, &endb, &pos, &v) { } else { panic(241); };
    if config_acl_allows_bytes(STR_PTR("10.1.2.3"), STR_LEN("10.1.2.3"), &oct, &endb, &pos, &v) { panic(242); };
    if config_acl_allows_bytes(STR_PTR("172.16.5.4"), STR_LEN("172.16.5.4"), &oct, &endb, &pos, &v) { panic(243); };
    if config_acl_allows_bytes(STR_PTR("192.168.1.1"), STR_LEN("192.168.1.1"), &oct, &endb, &pos, &v) { panic(244); };
    if config_acl_allows_bytes(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), &oct, &endb, &pos, &v) { } else { panic(245); };
    if config_acl_allows_bytes(STR_PTR("not-an-ip"), STR_LEN("not-an-ip"), &oct, &endb, &pos, &v) { panic(246); };
    if config_acl_allows_bytes(STR_PTR("::1"), STR_LEN("::1"), &oct, &endb, &pos, &v) { } else { panic(247); };
    if config_acl_allows_bytes(STR_PTR("2001:db8::1"), STR_LEN("2001:db8::1"), &oct, &endb, &pos, &v) { } else { panic(248); };
    if config_acl_allows_bytes(STR_PTR("::ffff:192.0.2.1"), STR_LEN("::ffff:192.0.2.1"), &oct, &endb, &pos, &v) { } else { panic(249); };
}
