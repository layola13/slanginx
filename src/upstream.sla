// upstream: reverse-proxy configuration data -- upstream pools
// and prefix routes -- plus the pure selection logic over it.
//
// Pools and routes are declared in the TOML layer:
//
//   [upstream.0]
//   name = "api"
//   servers = "127.0.0.1:19001, 127.0.0.1:19002"
//
//   [route.0]
//   prefix = "/api/"
//   upstream = "api"
//
// A route forwards the full normalized path (no prefix
// stripping -- the proxy_pass-without-URI form). Matching is by
// longest stored prefix; the stored prefix is the TOML text
// with one leading '/' removed, because normalized request
// paths carry no leading slash. Selection inside a pool is
// round-robin; the cursor lives in this config struct (server
// core state, not handler state -- see docs/HANDLER_MODEL.md).
//
// All storage is fixed arrays, per the house rule for config
// structs (no String fields; see settings.sla).

@import "sa_std/encoding/toml.sai"
@import "sa_std/encoding/toml.sla"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/task.sai"
@import "sa_std/sync/atomic.sa"
@import "sa_std/sync/atomic.sal"

const PROXY_MAX_POOLS: u64 = 4;
const PROXY_MAX_SERVERS: u64 = 4;
const PROXY_MAX_ROUTES: u64 = 8;
const PROXY_POOL_NAME_MAX: u64 = 31;
const PROXY_HOST_MAX: u64 = 63;
const PROXY_PREFIX_MAX: u64 = 127;

struct ProxyConfig {
    pool_names: [u8; 128],
    pool_name_lens: [u64; 4],
    pool_server_counts: [u64; 4],
    // Per-pool round-robin ticket counters (pickfix). One
    // AtomicUsize per pool, held as scalar fields: an atomic
    // method call on an ARRAY element receiver currently
    // addresses the array's base cell whatever the index
    // (compiler defect; minimal repro in the pickfix probes,
    // registered in REPORT.md "proxy pick lock removal"),
    // while a field receiver addresses its own cell.
    // fetch_add issues tickets in one global order per pool --
    // the same strict round-robin sequence the boot-installed
    // cursor mutex used to serialise -- with no lock anywhere
    // on the pick path. Pools are capped at PROXY_MAX_POOLS.
    pool_cursor0: AtomicUsize,
    pool_cursor1: AtomicUsize,
    pool_cursor2: AtomicUsize,
    pool_cursor3: AtomicUsize,
    pool_count: u64,
    srv_hosts: [u8; 1024],
    srv_host_lens: [u64; 16],
    srv_ports: [u16; 16],
    route_prefixes: [u8; 1024],
    route_prefix_lens: [u64; 8],
    route_pools: [u64; 8],
    route_count: u64,
}

struct PathText {
    bytes: [u8; 64],
    len: u64,
}

fn proxyconf_new() -> ProxyConfig {
    // The cursor counters are constructed inline in the
    // literal: binding an AtomicUsize to a named local first
    // and moving it into the field trips the SAB verifier's
    // StackEscape (stack allocations cannot move), while the
    // inline form materialises in place (pickfix probes F24).
    return ProxyConfig {
        pool_names: [0u8; 128], pool_name_lens: [0u64; 4],
        pool_server_counts: [0u64; 4],
        pool_cursor0: AtomicUsize::new(0),
        pool_cursor1: AtomicUsize::new(0),
        pool_cursor2: AtomicUsize::new(0),
        pool_cursor3: AtomicUsize::new(0),
        pool_count: 0,
        srv_hosts: [0u8; 1024], srv_host_lens: [0u64; 16],
        srv_ports: [0u16; 16],
        route_prefixes: [0u8; 1024], route_prefix_lens: [0u64; 8],
        route_pools: [0u64; 8], route_count: 0,
    };
}

fn path_push(t: &PathText, src: ptr, n: u64) {
    let i: u64 = 0;
    while i < n {
        if t.len < 64 {
            t.bytes[t.len] = PTR_BYTE_AT(src, i);
            t.len = t.len + 1;
        };
        i = i + 1;
    }
}

// Index of the pool with this name, or -1.
fn proxyconf_find_pool(pc: &ProxyConfig, name: ptr, name_len: u64) -> i32 {
    let i: u64 = 0;
    while i < pc.pool_count {
        if pc.pool_name_lens[i] == name_len {
            let same: bool = true;
            let j: u64 = 0;
            while j < name_len {
                if pc.pool_names[i * 32 + j] != PTR_BYTE_AT(name, j) {
                    same = false;
                };
                j = j + 1;
            }
            if same {
                return i as i32;
            };
        };
        i = i + 1;
    }
    return -1;
}

// Parse a comma-separated server list ("host:port, host:port")
// into the pool's slots. Byte-level and total: any malformed
// entry (empty, no colon, bad port, too many servers) is an
// error -- configuration mistakes are startup failures, never
// silently dropped entries. Returns 0 ok / 3 bad list.
fn proxyconf_parse_servers(pc: &ProxyConfig, pool_idx: u64, p: ptr, n: u64) -> i32 {
    let count: u64 = 0;
    let pos: u64 = 0;
    let scanning: bool = true;
    while scanning {
        // segment [pos, seg_end)
        let seg_end: u64 = pos;
        while seg_end < n {
            if PTR_BYTE_AT(p, seg_end) == 44 {
                break;
            };
            seg_end = seg_end + 1;
        }
        // trim spaces inside the segment
        let a: u64 = pos;
        let b: u64 = seg_end;
        while a < b {
            if PTR_BYTE_AT(p, a) != 32 {
                break;
            };
            a = a + 1;
        }
        while b > a {
            if PTR_BYTE_AT(p, b - 1) != 32 {
                break;
            };
            b = b - 1;
        }
        if a >= b {
            return 3;
        };
        if count >= PROXY_MAX_SERVERS {
            return 3;
        };
        // last ':' inside [a, b)
        let colon: u64 = 0;
        let has_colon: bool = false;
        let k: u64 = a;
        while k < b {
            if PTR_BYTE_AT(p, k) == 58 {
                colon = k;
                has_colon = true;
            };
            k = k + 1;
        }
        if !has_colon {
            return 3;
        };
        let host_len: u64 = colon - a;
        if host_len == 0 {
            return 3;
        };
        if host_len > PROXY_HOST_MAX {
            return 3;
        };
        // port: digits only, 1..65535
        let port: u64 = 0;
        let digits: u64 = 0;
        let q: u64 = colon + 1;
        while q < b {
            let d: u8 = PTR_BYTE_AT(p, q);
            if d < 48 {
                return 3;
            };
            if d > 57 {
                return 3;
            };
            port = port * 10 + ((d - 48) as u64);
            digits = digits + 1;
            q = q + 1;
        }
        if digits == 0 {
            return 3;
        };
        if port < 1 {
            return 3;
        };
        if port > 65535 {
            return 3;
        };
        let slot: u64 = pool_idx * PROXY_MAX_SERVERS + count;
        let j: u64 = 0;
        while j < host_len {
            pc.srv_hosts[slot * 64 + j] = PTR_BYTE_AT(p, a + j);
            j = j + 1;
        }
        pc.srv_host_lens[slot] = host_len;
        pc.srv_ports[slot] = port as u16;
        count = count + 1;
        if seg_end >= n {
            scanning = false;
        } else {
            pos = seg_end + 1;
        };
    }
    if count == 0 {
        return 3;
    };
    pc.pool_server_counts[pool_idx] = count;
    return 0;
}

// Fill pools and routes from the parsed TOML doc.
// Returns 0 ok / 3 bad declaration.
fn proxyconf_fill(pc: &ProxyConfig, doc: u64) -> i32 {
    let i: u64 = 0;
    let pools_done: bool = false;
    while !pools_done {
        if i >= PROXY_MAX_POOLS {
            pools_done = true;
        } else {
            let path = PathText { bytes: [0u8; 64], len: 0 };
            path_push(&path, STR_PTR("upstream."), STR_LEN("upstream."));
            // append the index digit + ".name"
            let digit: [u8; 1] = [(48 + i) as u8];
            let dptr: ptr = PTR_BYTE_ADD(&digit, 0);
            path_push(&path, dptr, 1);
            path_push(&path, STR_PTR(".name"), STR_LEN(".name"));
            let pp: ptr = PTR_BYTE_ADD(&path.bytes, 0);
            let kind: u32 = 0;
            if sa_toml_kind(doc, pp, path.len, &kind) != 0 {
                pools_done = true;
            } else {
                if kind != SA_TOML_KIND_STRING {
                    return 3;
                };
                let vp: ptr = PTR_NULL();
                let vl: u64 = 0;
                if sa_toml_get_string(doc, pp, path.len, &vp, &vl) != 0 {
                    return 3;
                };
                if vl == 0 {
                    return 3;
                };
                if vl > PROXY_POOL_NAME_MAX {
                    return 3;
                };
                if proxyconf_find_pool(pc, vp, vl) >= 0 {
                    return 3;
                };
                let j: u64 = 0;
                while j < vl {
                    pc.pool_names[i * 32 + j] = PTR_BYTE_AT(vp, j);
                    j = j + 1;
                }
                pc.pool_name_lens[i] = vl;
                pc.pool_count = i + 1;
                // servers (required string)
                let spath = PathText { bytes: [0u8; 64], len: 0 };
                path_push(&spath, STR_PTR("upstream."), STR_LEN("upstream."));
                path_push(&spath, dptr, 1);
                path_push(&spath, STR_PTR(".servers"), STR_LEN(".servers"));
                let spp: ptr = PTR_BYTE_ADD(&spath.bytes, 0);
                let skind: u32 = 0;
                if sa_toml_kind(doc, spp, spath.len, &skind) != 0 {
                    return 3;
                };
                if skind != SA_TOML_KIND_STRING {
                    return 3;
                };
                let sv: ptr = PTR_NULL();
                let sl: u64 = 0;
                if sa_toml_get_string(doc, spp, spath.len, &sv, &sl) != 0 {
                    return 3;
                };
                if proxyconf_parse_servers(pc, i, sv, sl) != 0 {
                    return 3;
                };
                i = i + 1;
            };
        };
    }
    let r: u64 = 0;
    let routes_done: bool = false;
    while !routes_done {
        if r >= PROXY_MAX_ROUTES {
            routes_done = true;
        } else {
            let path = PathText { bytes: [0u8; 64], len: 0 };
            path_push(&path, STR_PTR("route."), STR_LEN("route."));
            let digit: [u8; 1] = [(48 + r) as u8];
            let dptr: ptr = PTR_BYTE_ADD(&digit, 0);
            path_push(&path, dptr, 1);
            path_push(&path, STR_PTR(".prefix"), STR_LEN(".prefix"));
            let pp: ptr = PTR_BYTE_ADD(&path.bytes, 0);
            let kind: u32 = 0;
            if sa_toml_kind(doc, pp, path.len, &kind) != 0 {
                routes_done = true;
            } else {
                if kind != SA_TOML_KIND_STRING {
                    return 3;
                };
                let vp: ptr = PTR_NULL();
                let vl: u64 = 0;
                if sa_toml_get_string(doc, pp, path.len, &vp, &vl) != 0 {
                    return 3;
                };
                // store without one leading '/'
                let off: u64 = 0;
                if vl > 0 {
                    if PTR_BYTE_AT(vp, 0) == 47 {
                        off = 1;
                    };
                };
                let stored: u64 = vl - off;
                if stored > PROXY_PREFIX_MAX {
                    return 3;
                };
                let j: u64 = 0;
                while j < stored {
                    pc.route_prefixes[r * 128 + j] = PTR_BYTE_AT(vp, off + j);
                    j = j + 1;
                }
                pc.route_prefix_lens[r] = stored;
                // upstream name (required, must resolve)
                let upath = PathText { bytes: [0u8; 64], len: 0 };
                path_push(&upath, STR_PTR("route."), STR_LEN("route."));
                path_push(&upath, dptr, 1);
                path_push(&upath, STR_PTR(".upstream"), STR_LEN(".upstream"));
                let upp: ptr = PTR_BYTE_ADD(&upath.bytes, 0);
                let ukind: u32 = 0;
                if sa_toml_kind(doc, upp, upath.len, &ukind) != 0 {
                    return 3;
                };
                if ukind != SA_TOML_KIND_STRING {
                    return 3;
                };
                let uv: ptr = PTR_NULL();
                let ul: u64 = 0;
                if sa_toml_get_string(doc, upp, upath.len, &uv, &ul) != 0 {
                    return 3;
                };
                let pool_idx: i32 = proxyconf_find_pool(pc, uv, ul);
                if pool_idx < 0 {
                    return 3;
                };
                pc.route_pools[r] = pool_idx as u64;
                pc.route_count = r + 1;
                r = r + 1;
            };
        };
    }
    return 0;
}

// Longest-prefix route match over the normalized path.
// Returns the route index, or -1 when no route matches.
fn proxyconf_route_match(pc: &ProxyConfig, norm: ptr, norm_len: u64) -> i32 {
    let best: i32 = -1;
    let best_len: u64 = 0;
    let i: u64 = 0;
    while i < pc.route_count {
        let plen: u64 = pc.route_prefix_lens[i];
        if plen <= norm_len {
            let better: bool = false;
            if best < 0 {
                better = true;
            } else {
                if plen > best_len {
                    better = true;
                };
            };
            if better {
                let same: bool = true;
                let j: u64 = 0;
                while j < plen {
                    if pc.route_prefixes[i * 128 + j] != PTR_BYTE_AT(norm, j) {
                        same = false;
                    };
                    j = j + 1;
                }
                if same {
                    best = i as i32;
                    best_len = plen;
                };
            };
        };
        i = i + 1;
    }
    return best;
}

// Pure round-robin step (unit-tested).
fn proxyconf_pick_at(cursor: u64, count: u64) -> u64 {
    return cursor % count;
}

// Issue the next round-robin ticket of a pool: one fetch_add
// on the pool's own atomic counter. pool_idx is always
// < PROXY_MAX_POOLS (parse caps pool_count there, and routes
// only carry parsed indices).
fn proxyconf_pool_ticket(pc: &ProxyConfig, pool_idx: u64) -> u64 {
    if pool_idx == 0 {
        return pc.pool_cursor0.fetch_add(1, Ordering::SeqCst);
    };
    if pool_idx == 1 {
        return pc.pool_cursor1.fetch_add(1, Ordering::SeqCst);
    };
    if pool_idx == 2 {
        return pc.pool_cursor2.fetch_add(1, Ordering::SeqCst);
    };
    return pc.pool_cursor3.fetch_add(1, Ordering::SeqCst);
}

// Pick the next server slot of a pool. The ticket IS the old
// mutex-guarded cursor value: fetch_add hands each pick a
// unique ticket in the counter's global order, so ticket %
// server_count walks the pool in the same strict round-robin
// sequence the serialised read/advance pair produced --
// concurrent workers can neither observe the same cursor nor
// skew the distribution, and no lock is taken.
fn proxyconf_pool_pick(pc: &ProxyConfig, pool_idx: u64) -> u64 {
    let count: u64 = pc.pool_server_counts[pool_idx];
    let ticket: u64 = proxyconf_pool_ticket(pc, pool_idx);
    let at: u64 = proxyconf_pick_at(ticket, count);
    return pool_idx * PROXY_MAX_SERVERS + at;
}
