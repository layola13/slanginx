// access_log: one line per request, appended to the file named by
// the TOML layer (server.access_log).
//
// Line format (space-separated, combined-log style minus the
// timestamp and referer fields):
//
//   <remote> <method> <path> <status> <body-bytes> "<user-agent>"
//
// <remote> is the client address. The std HTTP server face has no
// peer-address getter for a request handle, so until that surface
// exists the caller passes "-" and this module writes it verbatim;
// the gap is registered in docs/M0_DELIVERY.md.

@import "sa_std/fs.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "numfmt.sla"

struct LogLine {
    bytes: [u8; 2048],
    len: u64,
}

fn logline_new() -> LogLine {
    return LogLine { bytes: [0u8; 2048], len: 0 };
}

fn logline_push(l: &LogLine, src: ptr, n: u64) {
    let i: u64 = 0;
    while i < n {
        if l.len < 2048 {
            l.bytes[l.len] = PTR_BYTE_AT(src, i);
            l.len = l.len + 1;
        };
        i = i + 1;
    }
}

fn logline_push_byte(l: &LogLine, b: u8) {
    if l.len < 2048 {
        l.bytes[l.len] = b;
        l.len = l.len + 1;
    };
}

fn logline_push_dec(l: &LogLine, v: u64) {
    let d = dec_u64(v);
    let i: u64 = 0;
    while i < d.len {
        logline_push_byte(l, d.bytes[i]);
        i = i + 1;
    }
}

// Open the log for append and close it again: startup probe so a
// bad log path fails fast at boot (nginx behavior), not silently
// per request.
fn access_log_probe(log_ptr: ptr, log_len: u64) -> i32 {
    let fh: u64 = 0;
    let ost: i32 = sa_std_fs_open_write(log_ptr, log_len, 0, &fh);
    if ost != 0 {
        return ost;
    };
    let pos: u64 = 0;
    let sst: i32 = sa_std_fs_file_seek(fh, 2, 0, &pos);
    sa_fs_file_close(fh);
    return sst;
}

fn access_log_append(log_ptr: ptr, log_len: u64,
                     remote_ptr: ptr, remote_len: u64,
                     method_ptr: ptr, method_len: u64,
                     path_ptr: ptr, path_len: u64,
                     status: u32, body_bytes: u64,
                     ua_ptr: ptr, ua_len: u64) -> i32 {
    let line = logline_new();
    logline_push(&line, remote_ptr, remote_len);
    logline_push_byte(&line, 32);
    logline_push(&line, method_ptr, method_len);
    logline_push_byte(&line, 32);
    logline_push(&line, path_ptr, path_len);
    logline_push_byte(&line, 32);
    logline_push_dec(&line, status as u64);
    logline_push_byte(&line, 32);
    logline_push_dec(&line, body_bytes);
    logline_push_byte(&line, 32);
    logline_push_byte(&line, 34);
    logline_push(&line, ua_ptr, ua_len);
    logline_push_byte(&line, 34);
    logline_push_byte(&line, 10);
    let fh: u64 = 0;
    let ost: i32 = sa_std_fs_open_write(log_ptr, log_len, 0, &fh);
    if ost != 0 {
        return ost;
    };
    let pos: u64 = 0;
    sa_std_fs_file_seek(fh, 2, 0, &pos);
    let line_ptr: ptr = PTR_BYTE_ADD(&line.bytes, 0);
    let written: u64 = 0;
    let wst: i32 = sa_std_fs_file_write(fh, line_ptr, line.len, &written);
    sa_fs_file_close(fh);
    return wst;
}
