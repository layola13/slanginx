// access_log: one line per request, appended to the file named by
// the TOML layer (server.access_log).
//
// Line format (space-separated, combined-log style minus the
// timestamp and referer fields):
//
//   <remote> <method> <path> <status> <body-bytes> "<user-agent>"
//
// <remote> is the client address (the G2 peer getter's value,
// wired by the caller; "-" when the peer is unknown).
//
// Syscall shape (F3): M1 opened, sought and closed the log file
// for EVERY request -- open/write/close plus a path resolution
// per line, ~53 us/request in the M1 strace attribution
// (docs/M1_DELIVERY.md section 5). The sink now opens the file
// ONCE at boot (which doubles as the old fail-fast probe: a bad
// log path still fails the boot, never silently per request),
// seeks to the end once, and writes each assembled line with a
// single write_all on the persistent handle: one syscall per
// line, none for open/seek/close. The handle is never re-opened
// at runtime, so if the file is truncated or rotated externally
// the operator restarts slanginx to pick up the new file. A
// failed write returns its status and that line is dropped --
// the same visibility contract as M1's failed per-request open.
//
// Batching (task 82, fix 4): access_log_append now ACCUMULATES
// lines in the sink buffer (8192 B) and only writes on flush.
// The supervisor flushes at the end of every drain sweep
// (drain_all_workers, ~1 ms cadence in the merged model), so a
// line is visible at most ~1 ms after it is appended, and the
// log write rate drops from 1/req to ~1/sweep (~0.05/req at
// 20k req/s). The buffer also flushes itself when it has less
// than one worst-case line (2048 B) of headroom, so a line is
// never split across a flush and no line is lost if the
// supervisor sweep is delayed. If the process is killed, the
// lines still in the buffer (at most ~1 ms worth) are lost --
// the same exposure a per-line write has to a kill between the
// handler and the write, just widened to one sweep.

@import "sa_std/fs.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "numfmt.sla"

struct LogSink {
    fh: u64,
    ready: bool,
    bytes: [u8; 8192],
    len: u64,
    // Caller-owned decimal scratch for sink_push_dec
    // (DEF-SLANGINX-REQ-MEM-GROWTH): the by-value dec_u64
    // return materialized on the heap twice per log line.
    dec: DecText,
}

fn logsink_new() -> LogSink {
    return LogSink { fh: 0, ready: false, bytes: [0u8; 8192], len: 0, dec: DecText { bytes: [0u8; 20], len: 0 } };
}

fn sink_push(s: &LogSink, src: ptr, n: u64) {
    let i: u64 = 0;
    while i < n {
        if s.len < 8192 {
            s.bytes[s.len] = PTR_BYTE_AT(src, i);
            s.len = s.len + 1;
        };
        i = i + 1;
    }
}

fn sink_push_byte(s: &LogSink, b: u8) {
    if s.len < 8192 {
        s.bytes[s.len] = b;
        s.len = s.len + 1;
    };
}

fn sink_push_dec(s: &LogSink, v: u64) {
    dec_u64_into(v, &s.dec);
    let i: u64 = 0;
    while i < s.dec.len {
        sink_push_byte(s, s.dec.bytes[i]);
        i = i + 1;
    }
}

// Open the log once, for append: create-if-missing without
// truncating (open_write with truncate=0), then seek to the end
// once. Any failure is returned so the boot fails fast, exactly
// like the M1 probe.
fn access_log_open(s: &LogSink, log_ptr: ptr, log_len: u64) -> i32 {
    let fh: u64 = 0;
    let ost: i32 = sa_std_fs_open_write(log_ptr, log_len, 0, &fh);
    if ost != 0 {
        return ost;
    };
    let pos: u64 = 0;
    let sst: i32 = sa_std_fs_file_seek(fh, 2, 0, &pos);
    if sst != 0 {
        sa_fs_file_close(fh);
        return sst;
    };
    s.fh = fh;
    s.ready = true;
    return 0;
}

// Write out whatever lines have accumulated since the last
// flush. A no-op when the buffer is empty (no syscall), so it
// is safe to call on every supervisor sweep.
fn access_log_flush(s: &LogSink) -> i32 {
    if !s.ready {
        return 1;
    };
    if s.len == 0 {
        return 0;
    };
    let line_ptr: ptr = PTR_BYTE_ADD(&s.bytes, 0);
    let rc: i32 = sa_fs_file_write_all(s.fh, line_ptr, s.len);
    s.len = 0;
    return rc;
}

fn access_log_append(s: &LogSink,
                     remote_ptr: ptr, remote_len: u64,
                     method_ptr: ptr, method_len: u64,
                     path_ptr: ptr, path_len: u64,
                     status: u32, body_bytes: u64,
                     ua_ptr: ptr, ua_len: u64) -> i32 {
    if !s.ready {
        return 1;
    };
    // Batching: flush first when less than one worst-case line
    // (2048 B) of headroom remains, so the line appended below
    // always lands whole in the buffer.
    if s.len > 6144 {
        let frc: i32 = access_log_flush(s);
        if frc != 0 {
            return frc;
        };
    };
    sink_push(s, remote_ptr, remote_len);
    sink_push_byte(s, 32);
    sink_push(s, method_ptr, method_len);
    sink_push_byte(s, 32);
    sink_push(s, path_ptr, path_len);
    sink_push_byte(s, 32);
    sink_push_dec(s, status as u64);
    sink_push_byte(s, 32);
    sink_push_dec(s, body_bytes);
    sink_push_byte(s, 32);
    sink_push_byte(s, 34);
    sink_push(s, ua_ptr, ua_len);
    sink_push_byte(s, 34);
    sink_push_byte(s, 10);
    return 0;
}
