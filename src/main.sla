// slanginx: an SLA-native web server (nginx-class), M0 + M1.
//
// M0 scope: static file serving over the sa_std built-in HTTP/1.1
// server face (std, not a plugin), two-layer configuration
// (settings.sla = TOML data layer, config.sla = SLA code layer),
// and an access log.
//
// M1 adds: the G1/G2 std backfills (HEAD via resp_send_head_v2;
// peer address via req_peer_addr_v2 feeding the access log's
// remote field and the live code-layer ACL), reverse proxying
// with TOML-declared upstream pools (proxy.sla / upstream.sla),
// and shared dict zones (shared_dict.sla) per the final
// handler-model ruling in docs/HANDLER_MODEL.md.
//
// The improvement line closes the remaining M1 registrations:
// D6 (client HEAD crashed/blocked in the std client -- fixed in
// sa_std, so the proxy fetches HEAD as HEAD again), G4 (the
// server face grew req_get_query_v2; the proxy forwards the
// query), G5 (the std client honors add_header for user-agent
// and the other slotted standard headers), F3 (the access log
// holds one persistent handle and writes each line with a single
// write_all -- access_log.sla), and G3' (the server face grew
// resp_send_file_v2; static GET is served by sendfile, see the
// GET path below).
//
// Process model: single process; a dispatcher accepts requests
// and hands each one to a per-connection goroutine supervised
// inline (stage 2, docs/GOROUTINE_DELIVERY.md). Handlers hold no
// state; cross-request state lives only in declared shared dict
// zones (docs/HANDLER_MODEL.md), the boot-built server context,
// and the dispatcher-owned slot table.

@import "sa_std/http_server.sai"
@import "sa_std/fs.sai"
@import "sa_std/os/fd.sai"
@import "sa_std/env.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/io/print.sai"
@import "sa_std/task.sai"
@import "sa_std/core/box.sa"
@import "settings.sla"
@import "config.sla"
@import "webpath.sla"
@import "access_log.sla"
@import "numfmt.sla"
@import "upstream.sla"
@import "shared_dict.sla"
@import "proxy.sla"

struct Outcome {
    status: u32,
    body_bytes: u64,
    method: [u8; 16],
    method_len: u64,
    path: [u8; 1024],
    path_len: u64,
    ua: [u8; 256],
    ua_len: u64,
    remote: [u8; 64],
    remote_len: u64,
}

// Reset an Outcome in place. The handler fills a caller-owned
// Outcome (the dispatcher's slot) through &Outcome; this struct
// used to be returned by value, which materialized ~1,424 bytes
// on the heap per request, unreclaimed (stage-2 slope segment 1;
// see docs/GOROUTINE_DELIVERY.md).
fn outcome_init(o: &Outcome) {
    o.status = 0;
    o.body_bytes = 0;
    o.method_len = 0;
    o.path_len = 0;
    o.ua_len = 0;
    o.remote_len = 0;
    let i: u64 = 0;
    while i < 1024 {
        o.path[i] = 0;
        i = i + 1;
    }
    let j: u64 = 0;
    while j < 256 {
        o.ua[j] = 0;
        j = j + 1;
    }
    let k: u64 = 0;
    while k < 64 {
        o.remote[k] = 0;
        k = k + 1;
    }
    let m: u64 = 0;
    while m < 16 {
        o.method[m] = 0;
        m = m + 1;
    }
}

fn copy_capped_16(o: &Outcome, src: ptr, n: u64) {
    let cap: u64 = n;
    if cap > 16 {
        cap = 16;
    };
    let i: u64 = 0;
    while i < cap {
        o.method[i] = PTR_BYTE_AT(src, i);
        i = i + 1;
    }
    o.method_len = cap;
}

fn copy_capped_1024(o: &Outcome, src: ptr, n: u64) {
    let cap: u64 = n;
    if cap > 1024 {
        cap = 1024;
    };
    let i: u64 = 0;
    while i < cap {
        o.path[i] = PTR_BYTE_AT(src, i);
        i = i + 1;
    }
    o.path_len = cap;
}

fn copy_capped_256(o: &Outcome, src: ptr, n: u64) {
    let cap: u64 = n;
    if cap > 256 {
        cap = 256;
    };
    let i: u64 = 0;
    while i < cap {
        o.ua[i] = PTR_BYTE_AT(src, i);
        i = i + 1;
    }
    o.ua_len = cap;
}

fn copy_capped_64(o: &Outcome, src: ptr, n: u64) {
    let cap: u64 = n;
    if cap > 64 {
        cap = 64;
    };
    let i: u64 = 0;
    while i < cap {
        o.remote[i] = PTR_BYTE_AT(src, i);
        i = i + 1;
    }
    o.remote_len = cap;
}

// Send a small fixed-body response (errors). Returns the body
// length actually handed to the send call.
fn send_simple(req: ptr, status: u16, body: ptr, body_len: u64) -> u64 {
    let resp: ptr = PTR_NULL();
    if sa_http_server_resp_new_v2(req, status, &resp) != 0 {
        return 0;
    };
    sa_http_server_resp_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), STR_PTR("text/plain"), STR_LEN("text/plain"));
    if sa_http_server_resp_send_v2(resp, body, body_len, 5000) != 0 {
        sa_http_server_resp_free_v2(resp);
        return 0;
    };
    sa_http_server_resp_free_v2(resp);
    return body_len;
}

fn handle_request(req: ptr, s: &Settings, pc: &ProxyConfig, dz: &DictZones, o: &Outcome) {
    outcome_init(o);
    // --- request line data ---
    let m_ptr: ptr = PTR_NULL();
    let m_len: u64 = 0;
    let p_ptr: ptr = PTR_NULL();
    let p_len: u64 = 0;
    if sa_http_server_req_get_method(req, &m_ptr, &m_len) != 0 {
        o.status = 500;
        o.body_bytes = send_simple(req, 500, STR_PTR("internal error\n"), STR_LEN("internal error\n"));
        return;
    };
    if sa_http_server_req_get_path(req, &p_ptr, &p_len) != 0 {
        o.status = 500;
        o.body_bytes = send_simple(req, 500, STR_PTR("internal error\n"), STR_LEN("internal error\n"));
        return;
    };
    copy_capped_16(o, m_ptr, m_len);
    copy_capped_1024(o, p_ptr, p_len);
    // --- query string (G4 backfill): the server face grew a
    // query getter; the proxy appends it to the forward target.
    // An absent query is ok with length 0. A getter failure is
    // treated as no query (the path alone is still forwarded);
    // it cannot fabricate one. ---
    let q_ptr: ptr = PTR_NULL();
    let q_len: u64 = 0;
    if sa_http_server_req_get_query_v2(req, &q_ptr, &q_len) != 0 {
        q_len = 0;
    };
    let ua_ptr: ptr = PTR_NULL();
    let ua_len: u64 = 0;
    if sa_http_server_req_get_header(req, STR_PTR("user-agent"), STR_LEN("user-agent"), &ua_ptr, &ua_len) == 0 {
        copy_capped_256(o, ua_ptr, ua_len);
    } else {
        copy_capped_256(o, STR_PTR("-"), STR_LEN("-"));
    };
    let is_get: bool = bytes_eq_lit(m_ptr, m_len, STR_PTR("GET"), STR_LEN("GET"));
    let is_head: bool = bytes_eq_lit(m_ptr, m_len, STR_PTR("HEAD"), STR_LEN("HEAD"));
    // --- peer address (G2 backfill): the access log's remote
    // field and the code-layer ACL both read it. A failed fetch
    // logs "-" and skips the ACL (the failure stays visible in
    // every log line); it never fabricates an address. ---
    let peer_buf: [u8; 64] = [0u8; 64];
    let peer_ptr: ptr = PTR_BYTE_ADD(&peer_buf, 0);
    let peer_len: u64 = 0;
    let peer_port: u16 = 0;
    let peer_known: bool = false;
    if sa_http_server_req_peer_addr_v2(req, peer_ptr, 64, &peer_len, &peer_port) == 0 {
        peer_known = true;
        copy_capped_64(o, peer_ptr, peer_len);
    } else {
        copy_capped_64(o, STR_PTR("-"), STR_LEN("-"));
    };
    // --- code-layer ACL, evaluated per live request (G2) ---
    // Decided over the peer's raw bytes (config_acl_allows_bytes
    // mirrors the String predicate's decisions rule for rule);
    // the String-building form cost ~6,277 B/request of
    // unreclaimed temporaries (stage-2 slope segment 3).
    if peer_known {
        if !config_acl_allows_bytes(peer_ptr, peer_len) {
            o.status = 403;
            o.body_bytes = send_simple(req, 403, STR_PTR("forbidden\n"), STR_LEN("forbidden\n"));
            return;
        };
    };
    // --- path resolution (decode + normalize + containment) ---
    // Literal local, filled through &ResolvedPath by
    // webpath_resolve: a by-value resolved_new() return was part
    // of the stage-2 slope segment 2 (large-struct materialization).
    let resolved = ResolvedPath { bytes: [0u8; 1024], len: 0, ended_with_slash: false };
    let rrc: i32 = webpath_resolve(p_ptr, p_len, &resolved);
    if rrc == 1 {
        o.status = 403;
        o.body_bytes = send_simple(req, 403, STR_PTR("forbidden\n"), STR_LEN("forbidden\n"));
        return;
    };
    if rrc != 0 {
        o.status = 400;
        o.body_bytes = send_simple(req, 400, STR_PTR("bad request\n"), STR_LEN("bad request\n"));
        return;
    };
    let norm_ptr: ptr = PTR_BYTE_ADD(&resolved.bytes, 0);
    // --- code-layer deny rule ---
    if config_path_denied(norm_ptr, resolved.len) {
        o.status = 403;
        o.body_bytes = send_simple(req, 403, STR_PTR("forbidden\n"), STR_LEN("forbidden\n"));
        return;
    };
    // --- code-layer status route: shared dict readout ---
    if is_get {
        if bytes_eq_lit(norm_ptr, resolved.len, STR_PTR("__slanginx/status"), STR_LEN("__slanginx/status")) {
            let body = TextBuf { bytes: [0u8; 1600], len: 0 };
            if proxy_status_body(pc, dz, &body, dict_now()) == 0 {
                let body_ptr: ptr = PTR_BYTE_ADD(&body.bytes, 0);
                o.status = 200;
                o.body_bytes = send_simple(req, 200, body_ptr, body.len);
                return;
            };
            o.status = 404;
            o.body_bytes = send_simple(req, 404, STR_PTR("not found\n"), STR_LEN("not found\n"));
            return;
        };
    };
    // --- reverse-proxy routes (M1) ---
    let route_idx: i32 = proxyconf_route_match(pc, norm_ptr, resolved.len);
    if route_idx >= 0 {
        let remote_ptr: ptr = PTR_BYTE_ADD(&o.remote, 0);
        let pr = proxy_serve(req, pc, dz, route_idx,
                             m_ptr, m_len, p_ptr, p_len,
                             q_ptr, q_len,
                             norm_ptr, resolved.len,
                             remote_ptr, o.remote_len, peer_known,
                             dict_now());
        o.status = pr.status;
        o.body_bytes = pr.body_bytes;
        return;
    };
    // --- method gate for the static face (proxy routes accept
    // their own method set inside proxy.sla; the deny rule and
    // the ACL above deliberately run before this gate) ---
    if is_get {
    } else {
        if is_head {
        } else {
            let resp: ptr = PTR_NULL();
            o.status = 405;
            if sa_http_server_resp_new_v2(req, 405, &resp) == 0 {
                sa_http_server_resp_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), STR_PTR("text/plain"), STR_LEN("text/plain"));
                sa_http_server_resp_add_header_v2(resp, STR_PTR("allow"), STR_LEN("allow"), STR_PTR("GET, HEAD"), STR_LEN("GET, HEAD"));
                if sa_http_server_resp_send_v2(resp, STR_PTR("method not allowed\n"), STR_LEN("method not allowed\n"), 5000) == 0 {
                    o.body_bytes = STR_LEN("method not allowed\n");
                };
                sa_http_server_resp_free_v2(resp);
            };
            return;
        };
    };
    // --- code-layer routing: pick the root, strip the alias prefix ---
    let strip: u64 = 0;
    let force_index: bool = false;
    let use_assets: bool = config_route_is_assets(norm_ptr, resolved.len);
    if use_assets {
        if resolved.len == 6 {
            strip = 6;
            force_index = true;
        } else {
            strip = 7;
        };
    };
    // --- build the filesystem candidate path ---
    let cand: [u8; 1400] = [0u8; 1400];
    let cand_len: u64 = 0;
    if use_assets {
        let ar = AssetsRoot { bytes: [0u8; 128], len: 0 };
        config_assets_root_into(&ar);
        let i: u64 = 0;
        while i < ar.len {
            cand[cand_len] = ar.bytes[i];
            cand_len = cand_len + 1;
            i = i + 1;
        }
    } else {
        let i: u64 = 0;
        while i < s.root_len {
            cand[cand_len] = s.root[i];
            cand_len = cand_len + 1;
            i = i + 1;
        }
    };
    let rel_len: u64 = resolved.len - strip;
    if rel_len > 0 {
        cand[cand_len] = 47;
        cand_len = cand_len + 1;
        let i: u64 = 0;
        while i < rel_len {
            cand[cand_len] = resolved.bytes[strip + i];
            cand_len = cand_len + 1;
            i = i + 1;
        }
    };
    let need_index: bool = force_index;
    if rel_len == 0 {
        need_index = true;
    };
    if resolved.ended_with_slash {
        need_index = true;
    };
    if need_index {
        if cand_len > 0 {
            cand[cand_len] = 47;
            cand_len = cand_len + 1;
        };
        let i: u64 = 0;
        while i < s.index_len {
            cand[cand_len] = s.index[i];
            cand_len = cand_len + 1;
            i = i + 1;
        }
    };
    let cand_ptr: ptr = PTR_BYTE_ADD(&cand, 0);
    // --- existence, with the directory-index fallback ---
    let file_len: u64 = 0;
    if sa_std_fs_len(cand_ptr, cand_len, &file_len) != 0 {
        if need_index {
            o.status = 404;
            o.body_bytes = send_simple(req, 404, STR_PTR("not found\n"), STR_LEN("not found\n"));
            return;
        };
        // Maybe a directory addressed without a trailing slash:
        // retry with /<index> appended (served directly; M0 does
        // not issue nginx's 301 -- registered in the delivery doc).
        let saved: u64 = cand_len;
        cand[cand_len] = 47;
        cand_len = cand_len + 1;
        let i: u64 = 0;
        while i < s.index_len {
            cand[cand_len] = s.index[i];
            cand_len = cand_len + 1;
            i = i + 1;
        }
        if sa_std_fs_len(cand_ptr, cand_len, &file_len) != 0 {
            o.status = 404;
            o.body_bytes = send_simple(req, 404, STR_PTR("not found\n"), STR_LEN("not found\n"));
            return;
        };
    };
    // --- content type by extension ---
    let mime = MimeType { bytes: [0u8; 40], len: 0 };
    webpath_mime(cand_ptr, cand_len, &mime);
    let mime_ptr: ptr = PTR_BYTE_ADD(&mime.bytes, 0);
    // --- HEAD: headers only, no body bytes on the wire ---
    // G1 backfilled in M1: the std server face now has a
    // header-only send shape (sa_http_server_resp_send_head_v2),
    // so HEAD carries the resource's real content-length with
    // zero body bytes -- the shape M0 could not produce with any
    // of its three candidates (measured in docs/M0_DELIVERY.md).
    if is_head {
        let resp: ptr = PTR_NULL();
        o.status = 200;
        if sa_http_server_resp_new_v2(req, 200, &resp) != 0 {
            o.status = 500;
            return;
        };
        sa_http_server_resp_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), mime_ptr, mime.len);
        if sa_http_server_resp_send_head_v2(resp, file_len, 5000) != 0 {
            o.body_bytes = 0;
        };
        sa_http_server_resp_free_v2(resp);
        o.body_bytes = 0;
        return;
    };
    // --- GET: sendfile from disk (G3') ---
    // The server face grew a send-file response shape
    // (sa_http_server_resp_send_file_v2): the head is framed
    // with content-length = file_len and the body moves
    // kernel-side from the open file descriptor -- no whole-file
    // buffer, no userspace chunk loop, and no size cap (the
    // max_file_bytes setting no longer gates this path; it is
    // still parsed for config compatibility). This replaces the
    // M1 buffered/streaming pair at exactly the seam M1 marked.
    // The descriptor is the fs handle's borrowed raw fd
    // (sa_std_fd_as_raw); the handle stays the owner and is
    // closed after the send.
    let fh: u64 = 0;
    if sa_std_fs_open_read(cand_ptr, cand_len, &fh) != 0 {
        o.status = 404;
        o.body_bytes = send_simple(req, 404, STR_PTR("not found\n"), STR_LEN("not found\n"));
        return;
    };
    let raw_fd: i32 = -1;
    if sa_std_fd_as_raw(fh, &raw_fd) != 0 {
        sa_fs_file_close(fh);
        o.status = 500;
        o.body_bytes = send_simple(req, 500, STR_PTR("internal error\n"), STR_LEN("internal error\n"));
        return;
    };
    let resp: ptr = PTR_NULL();
    if sa_http_server_resp_new_v2(req, 200, &resp) != 0 {
        sa_fs_file_close(fh);
        o.status = 500;
        o.body_bytes = 0;
        return;
    };
    sa_http_server_resp_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), mime_ptr, mime.len);
    let sent: u64 = 0;
    let fst: u32 = sa_http_server_resp_send_file_v2(resp, raw_fd as i64, 0, file_len, 5000, &sent);
    sa_http_server_resp_free_v2(resp);
    sa_fs_file_close(fh);
    o.status = 200;
    o.body_bytes = sent;
    if fst == 8 {
        // Platform without sendfile: the face sent NOTHING, so
        // the request can still be answered -- explicitly, with
        // a logged 500. There is deliberately no buffered
        // fallback (registered in the delivery doc).
        println("slanginx: sendfile unsupported on this platform; static GET answered 500");
        o.status = 500;
        o.body_bytes = send_simple(req, 500, STR_PTR("internal error\n"), STR_LEN("internal error\n"));
        return;
    };
    // Any other nonzero status means the response was committed
    // and fell short (e.g. the file shrank after being measured):
    // body_bytes already reports the bytes that actually reached
    // the wire, and the connection is closed by the face because
    // the framing did not complete.
    return;
}

struct ConfigPath {
    bytes: [u8; 512],
    len: u64,
}

// Read $SLANGINX_CONFIG into a fixed buffer. Guard-return shape
// throughout: the env buffer handle is freed on the single path
// that created it and never crosses a control-flow merge (a
// conditional free + merge traps with PhiStateConflict).
fn env_config_path() -> ConfigPath {
    let cp = ConfigPath { bytes: [0u8; 512], len: 0 };
    if sa_env_has(STR_PTR("SLANGINX_CONFIG"), STR_LEN("SLANGINX_CONFIG")) != 0 {
        return cp;
    };
    let eb: u64 = sa_env_get(STR_PTR("SLANGINX_CONFIG"), STR_LEN("SLANGINX_CONFIG"));
    if eb == 0 {
        return cp;
    };
    let ep: ptr = sa_env_buffer_data(eb);
    let el: u64 = sa_env_buffer_len(eb);
    let i: u64 = 0;
    while i < el {
        if i < 512 {
            cp.bytes[i] = PTR_BYTE_AT(ep, i);
        };
        i = i + 1;
    }
    cp.len = el;
    if cp.len > 512 {
        cp.len = 512;
    };
    sa_env_buffer_free(eb);
    return cp;
}

// ----------------------------------------------------------------
// ----------------------------------------------------------------
// Stage-2 serve model (docs/GOROUTINE_DELIVERY.md)
//
// A single dispatcher (the main task) owns the slot table,
// the access-log sink, and trap accounting. It accepts
// requests itself (short poll), and for each request spawns
// the worker directly under the runtime's supervised
// boundary (go supervised); the worker runs the ordinary
// sequential handle_request for exactly one request, reports
// its slot on the completions channel, and the dispatcher
// joins the finished task when it recycles the slot, reading
// back any trap record then. Workers touch only their own
// slot's Outcome (filled in place), the read-only boot
// configuration, the globals-backed dict zones (internally
// serialized by sa_std), and the proxy cursor (mutex-guarded
// since this batch, see upstream.sla).
//
// Two measured runtime behaviors shape this design:
//
// (1) No supervisor goroutine. The per-connection supervisor
// shape (a supervisor task performing the spawn+join per
// request) panics the runtime after ~300k cumulative cycles
// on the current toolchain (PANIC code=60901, "reached
// unreachable code"; minimal repros probe_h5/probe_h6: the
// supervised and the plain variant die at the same count,
// while the same spawn+join cycle driven from the main task
// passes 705k cycles, probe_h7). The lethal ingredient is
// spawn/join driven from a non-main task, so every spawn and
// join lives on the main task; the supervision semantics
// (supervised boundary, per-slot trap record, dispatcher-side
// intensity accounting) are unchanged. A trapped worker
// never sends its completion (defer does not run on trap --
// probe_h7t2), so the dispatcher also runs a watchdog: a
// slot in flight far beyond any legitimate request lifetime
// is joined in place (instant for a trapped or finished
// worker) and recycled through the same trap path; see
// watchdog_scan.
//
// (2) Accept is pumped by the main task. Feeding the
// dispatcher from a separate acceptor goroutine stalls
// request delivery for seconds at a time under sustained
// load on the current toolchain (the whole process parks,
// zero CPU, while requests sit undelivered; the identical
// server with main-task accept sustains full rate with zero
// errors over 120k requests -- line diag runs, 2026-10-30).
// The std server face evidently expects its accept entry to
// be driven from the consumer's own loop, as the sequential
// model did. The dispatcher therefore accepts in its own
// loop with a short poll (ACCEPT_POLL_MS), which also keeps
// completion draining ahead of new work by construction.
// The poll slice quantizes single-connection latency (the
// face does not return early for queued keep-alive requests:
// measured c1 p50 ~= the poll slice), so the slice is 1 ms:
// c1 780 rps / p99 1.7 ms at 1 ms vs 186 rps / p99 5.6 ms at
// 5 ms, c10 throughput unchanged (~5.6k rps both).
//
// 2026-10-31 root-cause correction: the quantization was not
// the face's poll -- it was this dispatcher's release order.
// A keep-alive connection re-enters the face's pool only when
// its request handle is released, and the release used to run
// in recycle_completion, i.e. only after the parked accept
// returned and the completion was drained; the parked accept
// therefore could not see the queued next request until the
// slice expired. The worker now releases its own handle
// before sending its completion (see conn_worker), so the
// pooled fd wakes the dispatcher's poll directly. The slice
// still bounds the fresh-connection head-parse budget inside
// sa_http_server_accept_v2 (its timeout is shared between the
// readiness poll and the bounded accept), which is why it
// stays small: at 1 ms a fresh connection whose headers miss
// the budget window under load is closed unanswered.
//
// Generational rotation bounds the loop stack ratchet (a
// codegen-level defect tracked separately: loop-body
// stack_alloc does not rewind per iteration, ~13-16
// B/iteration on a long-lived loop's stack; the main task
// dies at RLIMIT_STACK, default 8 MiB, after ~523k
// accept-loop iterations). The dispatcher consumes
// GEN_EVENT_BUDGET = 20,000 events per generation (at even
// 128 B/event of ratchet that is 2.56 MB, under a third of
// the 8 MiB main stack), then stops dispatching, drains
// in-flight work, and returns to serve(), which immediately
// calls the next generation on a fresh frame. Spawned
// workers run exactly one request, so their frames never
// loop and need no rotation.
//
// Trap policy: a trapped worker never kills the process by
// itself -- its slot completes with the recorded outcome (a
// synthetic 500 when the trap hit before any status was set)
// and the request is logged and freed as usual. More than
// TRAP_LIMIT traps inside TRAP_WINDOW_S seconds means the
// process is sick, not unlucky: the dispatcher fails loudly
// (exit code 3) instead of serving on silently.
// ----------------------------------------------------------------

const CONN_SLOTS: u64 = 64;
const GEN_EVENT_BUDGET: u64 = 20000;
const TRAP_LIMIT: u64 = 32;
const TRAP_WINDOW_S: u64 = 60;
const ACCEPT_POLL_MS: u32 = 1;
// Watchdog reaping ages for stuck slots (see watchdog_scan).
// The std fetch cap is 180 s, so any request older than that
// is either trapped, wedged, or a sendfile to an extremely
// slow reader; the routine bound (1,800 s) declares it
// wedged -- a reader slower than ~120 B/s on the largest
// file is indistinguishable from a wedge, and the join stall
// is bounded by that transfer's remainder. When no slot is
// free the dispatcher is not serving anyway, so the
// aggressive bound (300 s) applies: joining a trapped worker
// returns at once, and joining a merely slow one can only
// stall a dispatcher that is already stalled.
const TRAP_REAP_AFTER_S: u64 = 300;
const TRAP_REAP_MAX_S: u64 = 1800;

struct ServerCtx {
    settings: Settings,
    proxy: ProxyConfig,
    zones: DictZones,
    sink: LogSink,
    srv: ptr,
    completions: Chan<u64>,
    slots: [*ConnSlot; 64],
    // Round-2 merged serve model fields (used only when
    // merged is true; the dispatch model never touches them).
    results: Chan<u64>,
    workers: [*WorkerState; 64],
    worker_count: u64,
    merged: bool,
    debug_sup: bool,
}

struct ConnSlot {
    idx: u64,
    req: ptr,
    outcome: Outcome,
    trapped: bool,
    trap_code: i32,
    // Dispatcher-side supervision state: the supervised task
    // handle, whether a request is in flight, its dispatch
    // time (dict_now seconds), and a per-slot dispatch
    // sequence number. The completion payload packs idx and
    // seq so the dispatcher can recognize a stale completion
    // (one whose slot the watchdog already reaped).
    handle: u64,
    busy: bool,
    started: u64,
    seq: u64,
    // True when the worker itself released the request handle
    // (sa_http_server_req_free_v2) before sending its
    // completion; the dispatcher then skips its own release in
    // recycle_completion. Stays false for trapped workers (the
    // dispatcher releases after joining them) and for workers
    // the watchdog reaped mid-flight (their seq check fails,
    // so they skip the release and the dispatcher does it).
    req_released: bool,
}

struct ConnJob {
    ctx: *ServerCtx,
    slot: *ConnSlot,
}

fn conn_slot_new(idx: u64) -> *ConnSlot {
    return Box::into_raw(Box::new(ConnSlot {
        idx: idx, req: PTR_NULL(),
        outcome: Outcome {
            status: 0, body_bytes: 0,
            method: [0u8; 16], method_len: 0,
            path: [0u8; 1024], path_len: 0,
            ua: [0u8; 256], ua_len: 0,
            remote: [0u8; 64], remote_len: 0,
        },
        trapped: false, trap_code: 0,
        handle: 0, busy: false, started: 0, seq: 0,
        req_released: false,
    }));
}

// The per-connection worker: run handle_request for exactly
// one request, release the request handle itself, report the
// slot on the completions channel (payload packs the slot idx
// and its dispatch sequence), and reclaim the job box. If the
// worker traps, the completion is never sent -- the
// dispatcher's watchdog reaps the slot by joining this task's
// handle (see watchdog_scan).
//
// The worker-side release is a latency fix (2026-10-31): the
// release is what returns a keep-alive connection to the std
// face's pool. When only the dispatcher released (after
// draining the completion), a parked accept_v2 call could not
// see the connection -- and the next request already queued
// on it -- until the poll slice expired, so every keep-alive
// request after the first paid a full ACCEPT_POLL_MS of dead
// latency (measured: c1 mean 38 ms at a 50 ms slice, ~= the
// slice at 1 ms). Releasing in the worker puts the connection
// back in the pool while the dispatcher is still parked, so
// its poll wakes on the pooled fd the moment the next request
// lands. The seq check keeps this safe against the watchdog:
// a slot reaped mid-flight has a bumped seq, so its worker
// skips the release and the dispatcher's recycle_completion
// (which joins the task before deciding) releases instead --
// exactly one release per request in every interleaving.
fn conn_worker(job: *ConnJob) {
    let ctx: *ServerCtx = (*job).ctx;
    let slot: *ConnSlot = (*job).slot;
    let my_seq: u64 = (*slot).seq;
    let payload: u64 = (*slot).idx * 4294967296 + (my_seq % 4294967296);
    handle_request((*slot).req, &(*ctx).settings, &(*ctx).proxy, &(*ctx).zones, &(*slot).outcome);
    if (*slot).seq == my_seq {
        sa_http_server_req_free_v2((*slot).req);
        (*slot).req_released = true;
    };
    (*ctx).completions.send(payload);
    let reclaimed = unsafe { Box::from_raw(job) };
}

// Join a slot's supervised task if it has not been joined
// yet, recording any trap in the slot. Called by the
// dispatcher when a slot is recycled (the common path: the
// worker already exited, so the join returns at once) and by
// the watchdog (the trap path: the worker trapped and never
// sent its completion).
fn join_slot_task(ctx: *ServerCtx, idx: u64) {
    let slot: *ConnSlot = (*ctx).slots[idx];
    let h: u64 = (*slot).handle;
    if h != 0 {
        (*slot).handle = 0;
        let st = sa_task_join(h);
        if st == 100 {
            (*slot).trapped = true;
            let code: i32 = 0;
            let msg_ptr: ptr = PTR_NULL();
            let msg_len: u64 = 0;
            if sa_task_trap_info(h, &code, &msg_ptr, &msg_len) == 0 {
                (*slot).trap_code = code;
            };
        };
    };
}

struct TrapState {
    count: u64,
    window_start: u64,
}

// Dispatcher-side completion handling for one finished slot:
// join the slot's task (collecting any trap record), append
// the access-log line for the recorded outcome, account the
// trap (if any) against the intensity limit, and free the
// request handle. Returns 3 when the trap intensity limit is
// breached -- serve() then fails the process loudly.
fn recycle_completion(ctx: *ServerCtx, idx: u64, traps: &TrapState) -> i32 {
    let slot: *ConnSlot = (*ctx).slots[idx];
    join_slot_task(ctx, idx);
    (*slot).busy = false;
    let status: u32 = (*slot).outcome.status;
    if (*slot).trapped {
        if status == 0 {
            status = 500;
        };
        let now: u64 = dict_now();
        if now >= traps.window_start + TRAP_WINDOW_S {
            traps.window_start = now;
            traps.count = 0;
        };
        traps.count = traps.count + 1;
    };
    access_log_append(&(*ctx).sink,
                      PTR_BYTE_ADD(&(*slot).outcome.remote, 0), (*slot).outcome.remote_len,
                      PTR_BYTE_ADD(&(*slot).outcome.method, 0), (*slot).outcome.method_len,
                      PTR_BYTE_ADD(&(*slot).outcome.path, 0), (*slot).outcome.path_len,
                      status, (*slot).outcome.body_bytes,
                      PTR_BYTE_ADD(&(*slot).outcome.ua, 0), (*slot).outcome.ua_len);
    // The worker normally released the handle itself before
    // sending its completion (see conn_worker); release here
    // only when it did not (trapped worker, or a worker the
    // watchdog reaped mid-flight whose seq check skipped its
    // release). join_slot_task above has already waited for
    // the worker to exit, so this cannot double-release.
    if !(*slot).req_released {
        sa_http_server_req_free_v2((*slot).req);
    };
    (*slot).req = PTR_NULL();
    if (*slot).trapped {
        if traps.count > TRAP_LIMIT {
            return 3;
        };
    };
    return 0;
}

// One dispatcher generation's mutable bookkeeping (the free
// slot stack, in-flight count, event count), passed by
// reference to the recycle/watchdog helpers.
struct GenBook {
    free_stack: [u64; 64],
    free_top: u64,
    in_flight: u64,
    events: u64,
}

// Process one completion payload: decode (idx, seq); a stale
// payload (the watchdog already reaped that dispatch) is
// dropped without touching the books. Otherwise recycle the
// slot and return it to the free stack.
fn book_recycle(ctx: *ServerCtx, book: &GenBook, payload: u64, traps: &TrapState) -> i32 {
    let idx: u64 = payload / 4294967296;
    let seq: u64 = payload % 4294967296;
    let slot: *ConnSlot = (*ctx).slots[idx];
    if seq != (*slot).seq % 4294967296 {
        return 0;
    };
    if !(*slot).busy {
        return 0;
    };
    let rc = recycle_completion(ctx, idx, traps);
    book.in_flight = book.in_flight - 1;
    book.free_stack[book.free_top] = idx;
    book.free_top = book.free_top + 1;
    return rc;
}

// Watchdog: reap slots whose request has been in flight far
// beyond any legitimate lifetime (see the TRAP_REAP_*
// constants). The worker in such a slot has trapped -- its
// completion never arrives because defer does not run on
// trap (probe_h7t2) -- or is wedged. recycle_completion
// joins the task in place: instant for a trapped or finished
// worker. The slot's seq is bumped first, so a completion
// the worker did manage to queue becomes stale and is
// dropped by book_recycle instead of double-recycling.
fn watchdog_scan(ctx: *ServerCtx, book: &GenBook, traps: &TrapState) -> i32 {
    let now: u64 = dict_now();
    let age_limit: u64 = TRAP_REAP_MAX_S;
    if book.free_top == 0 {
        age_limit = TRAP_REAP_AFTER_S;
    };
    let i: u64 = 0;
    while i < CONN_SLOTS {
        let slot: *ConnSlot = (*ctx).slots[i];
        if (*slot).busy {
            if now >= (*slot).started + age_limit {
                (*slot).seq = (*slot).seq + 1;
                let rc = recycle_completion(ctx, i, traps);
                book.in_flight = book.in_flight - 1;
                book.free_stack[book.free_top] = i;
                book.free_top = book.free_top + 1;
                if rc != 0 {
                    return rc;
                };
            };
        };
        i = i + 1;
    }
    return 0;
}

struct RecvBox {
    payload: u64,
    got: bool,
    closed: bool,
}

// Non-blocking completion receive (select/default).
//
// The dispatcher's channel waits use ONLY the select shapes:
// it never calls Chan::len() (a len() call in a nested
// while-condition after receives parks the task on the current
// toolchain — minimal repros in ~/workspace/sx-work/chan-len-hang/:
// the len-in-condition form hangs deterministically, the
// len-in-body and select shapes pass).
fn try_recv_completion(ctx: *ServerCtx, out: &RecvBox) {
    out.payload = 0;
    out.got = false;
    out.closed = false;
    select {
        case let (v, closed) = (*ctx).completions.recv() {
            out.payload = v;
            out.got = true;
            out.closed = closed;
        }
        default {
            out.got = false;
        }
    }
}

struct SelectBox {
    kind: u64,
    idx: u64,
    req: ptr,
    closed: bool,
}

// Blocking completion wait in 1 s slices: kind 1 = a
// completion arrived (idx holds the packed payload), kind 3
// = the slice timed out (the caller runs the watchdog).
fn select_completion(ctx: *ServerCtx, out: &SelectBox) {
    out.kind = 0;
    out.idx = 0;
    out.req = PTR_NULL();
    out.closed = false;
    select {
        case let (v, closed) = (*ctx).completions.recv() {
            out.kind = 1;
            out.idx = v;
            out.closed = closed;
        }
        timeout(1000000000) {
            out.kind = 3;
        }
    }
}

// Bind a request handle to a free slot and spawn its worker
// under the supervised boundary; the task handle, dispatch
// time, and sequence number stay in the slot for the
// dispatcher's recycle/watchdog joins. Slot free-stack
// bookkeeping stays with the caller.
fn start_request(ctx: *ServerCtx, slot_idx: u64, req: ptr) {
    let slot: *ConnSlot = (*ctx).slots[slot_idx];
    (*slot).req = req;
    (*slot).req_released = false;
    (*slot).trapped = false;
    (*slot).trap_code = 0;
    (*slot).seq = (*slot).seq + 1;
    (*slot).started = dict_now();
    (*slot).busy = true;
    outcome_init(&(*slot).outcome);
    let job = Box::into_raw(Box::new(ConnJob { ctx: ctx, slot: slot }));
    let h = go supervised conn_worker(job);
    (*slot).handle = h;
}

// One dispatcher generation: consume up to GEN_EVENT_BUDGET
// events (dispatches + completion recycles), then stop
// dispatching, drain in-flight completions, and return 0
// (serve() starts the next generation on a fresh frame).
// Each iteration first drains every queued completion
// (non-blocking), so recycling always runs ahead of new
// accepts; the watchdog runs on a ~1 Hz cadence (checked on
// loop iterations and on the blocking waits' timeout
// slices). Returns 3 on a trap intensity breach or an
// (impossible by construction) channel close. Slot count
// and the free-stack array size are the same constant by
// construction (CONN_SLOTS == 64).
fn serve_generation(ctx: *ServerCtx) -> i32 {
    let book = GenBook { free_stack: [0; 64], free_top: 0, in_flight: 0, events: 0 };
    let i: u64 = 0;
    while i < CONN_SLOTS {
        book.free_stack[book.free_top] = CONN_SLOTS - 1 - i;
        book.free_top = book.free_top + 1;
        i = i + 1;
    }
    let traps = TrapState { count: 0, window_start: dict_now() };
    let iter: u64 = 0;
    let last_scan: u64 = dict_now();
    while true {
        iter = iter + 1;
        if iter % 1024 == 0 {
            let now2: u64 = dict_now();
            if now2 != last_scan {
                last_scan = now2;
                let rcw0 = watchdog_scan(ctx, &book, &traps);
                if rcw0 != 0 {
                    return rcw0;
                };
            };
        };
        // Drain every queued completion first.
        let progressed: bool = true;
        while progressed {
            let rb = RecvBox { payload: 0, got: false, closed: false };
            try_recv_completion(ctx, &rb);
            if rb.closed {
                return 3;
            };
            if !rb.got {
                progressed = false;
            } else {
                let rcd = book_recycle(ctx, &book, rb.payload, &traps);
                if rcd != 0 {
                    return rcd;
                };
                book.events = book.events + 1;
            };
        }
        if book.events >= GEN_EVENT_BUDGET {
            // Draining for a generation change.
            if book.in_flight == 0 {
                return 0;
            };
            let sb = SelectBox { kind: 0, idx: 0, req: PTR_NULL(), closed: false };
            select_completion(ctx, &sb);
            if sb.closed {
                return 3;
            };
            if sb.kind == 1 {
                let rc = book_recycle(ctx, &book, sb.idx, &traps);
                if rc != 0 {
                    return rc;
                };
            } else {
                let rcw = watchdog_scan(ctx, &book, &traps);
                if rcw != 0 {
                    return rcw;
                };
            };
        } else {
            if book.free_top == 0 {
                // All slots busy: park on the next completion.
                let sb2 = SelectBox { kind: 0, idx: 0, req: PTR_NULL(), closed: false };
                select_completion(ctx, &sb2);
                if sb2.closed {
                    return 3;
                };
                if sb2.kind == 1 {
                    let rc2 = book_recycle(ctx, &book, sb2.idx, &traps);
                    if rc2 != 0 {
                        return rc2;
                    };
                    book.events = book.events + 1;
                } else {
                    let rcw2 = watchdog_scan(ctx, &book, &traps);
                    if rcw2 != 0 {
                        return rcw2;
                    };
                };
            } else {
                let req: ptr = PTR_NULL();
                let ast: u32 = sa_http_server_accept_v2((*ctx).srv, ACCEPT_POLL_MS, &req);
                if ast == 0 {
                    book.free_top = book.free_top - 1;
                    start_request(ctx, book.free_stack[book.free_top], req);
                    book.in_flight = book.in_flight + 1;
                    book.events = book.events + 1;
                };
            };
        };
    }
    return 0;
}

// Generation supervisor: run dispatcher generations back to
// back on fresh frames, forever; a nonzero generation result
// (trap intensity breach) is a loud process failure.
fn serve(ctx: *ServerCtx) -> i32 {
    while true {
        let rc = serve_generation(ctx);
        if rc != 0 {
            println("slanginx: trap intensity limit exceeded; failing loudly");
            return rc;
        };
    }
    return 0;
}

// ----------------------------------------------------------------
// Round-2 merged serve model (b1; design package
// slanginx-r2 DESIGN.md sections 5(b1)/7, supervision shape
// ruled by Jev: per-incarnation join, adopt_per_incarnation_join
// 0.99).
//
// W long-lived worker tasks each run the accept loop themselves
// on the shared server handle: accept_v2 (50 ms slice -- the
// slice is also the fresh-connection head-parse budget inside
// the face, so the merged model's longer slice widens that
// budget from the dispatcher's 1 ms) -> handle_request ->
// release the request handle themselves -> append their own
// access-log line under the log mutex (sub-shape alpha: the
// sink's staging buffer is part of the sink state, so the
// mutex covers line assembly as well as the write). There is
// no per-request spawn, no completion channel, and no central
// serial line: the connection pool's own multi-consumer design
// (pool lock + self-wake pipe in the std face) hands each
// ready connection to whichever worker accepts first, which is
// the "pool does overload transfer" property of the merged
// model, for free.
//
// Supervision moves from per-request join to per-incarnation
// join: a worker serves WORKER_REQ_BUDGET requests (bounding
// the loop-body stack ratchet the same way the dispatcher's
// generational budget does), exits normally, and is respawned
// by the supervisor. Each worker has a monitor task whose only
// job is to join that incarnation and report the outcome
// (normal exit with its served count, or trap with its trap
// code) on the results channel; the supervisor accounts traps
// against the same intensity policy as the dispatch model
// (more than TRAP_LIMIT inside TRAP_WINDOW_S seconds fails the
// process loudly, exit 3) and respawns the worker. Spawn+join
// driven from these monitor tasks is legal on the current
// toolchain (the 60901 non-main ceiling was retested gone by
// the design line: 1.2M cycles from a non-main driver, rc=0).
//
// Trap containment difference vs the dispatch model, by
// design: a worker that traps inside handle_request dies with
// its request handle unreleased -- the connection stays out of
// the pool until process exit. The intensity policy bounds
// the leak (at most TRAP_LIMIT+1 stranded connections before
// the process fails loudly and the OS reclaims every fd), and
// the supervisor still writes the trapped request's access-log
// line from the worker's outcome slot (synthetic 500 when no
// status was set), so log lines stay equal to served requests.
// The watchdog semantics migrate as progress supervision: each
// worker stamps the start of its in-flight request; a request
// older than the reap bound (TRAP_REAP_MAX_S, or
// TRAP_REAP_AFTER_S when every worker is busy) is declared a
// process-level fault and fails loudly (exit 4) -- the
// supervisor cannot join a wedged worker without stalling
// itself, so the process exit IS the reap.
// ----------------------------------------------------------------

const WORKER_ACCEPT_MS: u32 = 50;
const WORKER_REQ_BUDGET: u64 = 20000;
const MAX_WORKERS: u64 = 64;

struct WorkerState {
    idx: u64,
    active: bool,
    handle: u64,
    incarnation: u64,
    inc_served: u64,
    in_flight: bool,
    started: u64,
    req: ptr,
    trapped: bool,
    trap_code: i32,
    // (b1-beta) double-buffered outcome slots: the worker
    // serves request seq into slot seq%2 and reports it on the
    // results channel; the supervisor appends the line from the
    // slot and advances log_done. log_seq/log_done live across
    // incarnations so a late record can never be overwritten
    // early. trap_line_pending marks a trapped in-flight
    // request whose line the supervisor appends itself once
    // earlier records have drained (log_done reaches log_seq).
    outcome_a: Outcome,
    outcome_b: Outcome,
    cur_slot: u64,
    log_seq: u64,
    log_done: u64,
    trap_line_pending: bool,
    trap_seq: u64,
    trap_slot: u64,
}

fn worker_state_new(idx: u64) -> *WorkerState {
    return Box::into_raw(Box::new(WorkerState {
        idx: idx, active: false, handle: 0, incarnation: 0,
        inc_served: 0, in_flight: false, started: 0, req: PTR_NULL(),
        trapped: false, trap_code: 0,
        outcome_a: Outcome {
            status: 0, body_bytes: 0,
            method: [0u8; 16], method_len: 0,
            path: [0u8; 1024], path_len: 0,
            ua: [0u8; 256], ua_len: 0,
            remote: [0u8; 64], remote_len: 0,
        },
        outcome_b: Outcome {
            status: 0, body_bytes: 0,
            method: [0u8; 16], method_len: 0,
            path: [0u8; 1024], path_len: 0,
            ua: [0u8; 256], ua_len: 0,
            remote: [0u8; 64], remote_len: 0,
        },
        cur_slot: 0, log_seq: 0, log_done: 0,
        trap_line_pending: false, trap_seq: 0, trap_slot: 0,
    }));
}

struct WorkerJob {
    ctx: *ServerCtx,
    ws: *WorkerState,
}

struct MonitorJob {
    ctx: *ServerCtx,
    ws: *WorkerState,
    handle: u64,
}

// The merged-model worker: accept and serve on the shared
// handle until the incarnation's request budget is spent,
// then return (the monitor reports the exit and the
// supervisor respawns a fresh incarnation). (b1-beta) lean
// supervision logging: the worker serves into its
// double-buffered outcome slot and reports the completion on
// the results channel; the supervisor is the only access-log
// writer. A trap anywhere between accept and the completion
// report still leaves a loggable in-flight request whose
// outcome the supervisor reads from the current slot.
fn merged_worker(job: *WorkerJob) {
    let ctx: *ServerCtx = (*job).ctx;
    let ws: *WorkerState = (*job).ws;
    let served: u64 = 0;
    (*ws).inc_served = 0;
    while served < WORKER_REQ_BUDGET {
        let req: ptr = PTR_NULL();
        let ast: u32 = sa_http_server_accept_v2((*ctx).srv, WORKER_ACCEPT_MS, &req);
        if ast == 0 {
            // Slot discipline: before reusing slot seq%2, the
            // record for seq-2 must have been appended
            // (log_done is written only by the supervisor; a
            // stale read can only lengthen this wait, never
            // corrupt a line).
            let seq: u64 = (*ws).log_seq;
            if seq >= 2 {
                while (*ws).log_done < seq - 1 {
                    sa_task_sleep_ms(1);
                }
            };
            let slot: u64 = seq % 2;
            (*ws).cur_slot = slot;
            (*ws).req = req;
            (*ws).started = dict_now();
            (*ws).in_flight = true;
            if slot == 0 {
                handle_request(req, &(*ctx).settings, &(*ctx).proxy, &(*ctx).zones, &(*ws).outcome_a);
            } else {
                handle_request(req, &(*ctx).settings, &(*ctx).proxy, &(*ctx).zones, &(*ws).outcome_b);
            };
            sa_http_server_req_free_v2(req);
            (*ws).req = PTR_NULL();
            (*ws).in_flight = false;
            (*ws).started = 0;
            // Completion record on the results channel: kind
            // bit 2^62, worker idx in bits 40..45, request seq
            // in the low 40 bits (exit payloads stay below
            // 2^38, so the kinds never collide).
            (*ctx).results.send(4611686018427387904 + (*ws).idx * 1099511627776 + seq);
            (*ws).log_seq = seq + 1;
            served = served + 1;
            (*ws).inc_served = served;
        } else {
            // Slice expired (or the face reported an error):
            // a 1 ms nap bounds any error spin; the event
            // path never pays it.
            sa_task_sleep_ms(1);
        };
    }
    let reclaimed = unsafe { Box::from_raw(job) };
}

// Per-incarnation monitor: join one worker incarnation and
// report the outcome on the results channel. Payload packs
// the worker idx in the high 32 bits; the low 32 bits are the
// served count for a normal exit, or 2^31 + |trap code| for a
// trapped exit.
fn worker_monitor(job: *MonitorJob) {
    let ctx: *ServerCtx = (*job).ctx;
    let ws: *WorkerState = (*job).ws;
    let h: u64 = (*job).handle;
    let st = sa_task_join(h);
    let low: u64 = (*ws).inc_served;
    if st == 100 {
        low = 2147483648;
        let code: i32 = 0;
        let msg_ptr: ptr = PTR_NULL();
        let msg_len: u64 = 0;
        if sa_task_trap_info(h, &code, &msg_ptr, &msg_len) == 0 {
            let c: i32 = code;
            if c < 0 {
                c = 0 - c;
            };
            low = 2147483648 + (c as u64);
        };
    };
    (*ctx).results.send((*ws).idx * 4294967296 + low);
    let reclaimed = unsafe { Box::from_raw(job) };
}

// Spawn one worker incarnation plus its monitor. The
// supervisor is the only caller, so incarnation bookkeeping
// has a single writer.
fn spawn_worker(ctx: *ServerCtx, idx: u64) {
    let ws: *WorkerState = (*ctx).workers[idx];
    (*ws).inc_served = 0;
    (*ws).in_flight = false;
    (*ws).started = 0;
    (*ws).req = PTR_NULL();
    (*ws).trapped = false;
    (*ws).trap_code = 0;
    (*ws).incarnation = (*ws).incarnation + 1;
    (*ws).active = true;
    let job = Box::into_raw(Box::new(WorkerJob { ctx: ctx, ws: ws }));
    let h = go supervised merged_worker(job);
    (*ws).handle = h;
    let mjob = Box::into_raw(Box::new(MonitorJob { ctx: ctx, ws: ws, handle: h }));
    let mh = go worker_monitor(mjob);
}

// Append one access-log line from a worker outcome slot.
// The supervisor is the only caller (single writer, no mutex).
fn append_outcome_line(ctx: *ServerCtx, o: &Outcome, status: u32) {
    access_log_append(&(*ctx).sink,
                      PTR_BYTE_ADD(&o.remote, 0), o.remote_len,
                      PTR_BYTE_ADD(&o.method, 0), o.method_len,
                      PTR_BYTE_ADD(&o.path, 0), o.path_len,
                      status, o.body_bytes,
                      PTR_BYTE_ADD(&o.ua, 0), o.ua_len);
}

// Consume one (b1-beta) completion record: append the line
// for (idx, seq) from its outcome slot and advance log_done.
// Records from one worker arrive in send order; a record whose
// seq is not the expected next one is out of discipline and is
// dropped (the wait in merged_worker makes it unreachable).
// Afterwards, a pending trapped line for this worker whose
// turn has come is appended from the current slot.
fn handle_log_record(ctx: *ServerCtx, payload: u64) {
    let idx: u64 = (payload / 1099511627776) % 64;
    let seq: u64 = payload % 1099511627776;
    let ws: *WorkerState = (*ctx).workers[idx];
    // A trapped line owed by the supervisor is appended as
    // soon as every earlier record has drained; its slot
    // content is still intact because the next incarnation
    // cannot reuse that slot before log_done passes trap_seq.
    if (*ws).trap_line_pending {
        if (*ws).log_done == (*ws).trap_seq {
            if (*ws).trap_slot == 0 {
                let status: u32 = (*ws).outcome_a.status;
                if status == 0 {
                    status = 500;
                };
                append_outcome_line(ctx, &(*ws).outcome_a, status);
            } else {
                let status: u32 = (*ws).outcome_b.status;
                if status == 0 {
                    status = 500;
                };
                append_outcome_line(ctx, &(*ws).outcome_b, status);
            };
            (*ws).log_done = (*ws).trap_seq + 1;
            (*ws).trap_line_pending = false;
        };
    };
    if seq != (*ws).log_done {
        return;
    };
    if seq % 2 == 0 {
        append_outcome_line(ctx, &(*ws).outcome_a, (*ws).outcome_a.status);
    } else {
        append_outcome_line(ctx, &(*ws).outcome_b, (*ws).outcome_b.status);
    };
    (*ws).log_done = seq + 1;
}

// Process one incarnation exit report: account traps against
// the intensity policy (same window semantics as
// recycle_completion), write the trapped request's log line if
// one was in flight, and respawn the worker. Returns 3 when
// the trap intensity limit is breached.
fn handle_exit_report(ctx: *ServerCtx, payload: u64, traps: &TrapState) -> i32 {
    let idx: u64 = payload / 4294967296;
    let low: u64 = payload % 4294967296;
    let ws: *WorkerState = (*ctx).workers[idx];
    (*ws).active = false;
    (*ws).handle = 0;
    if low >= 2147483648 {
        (*ws).trapped = true;
        (*ws).trap_code = (low - 2147483648) as i32;
        if (*ws).in_flight {
            // The trapped request's line is owed by the
            // supervisor itself. The worker is dead, so the
            // sequence can be advanced here: the line is
            // appended now if earlier records have drained
            // (log_done == log_seq), else it stays pending
            // until handle_log_record catches up (the slot is
            // not reused before then: the next incarnation's
            // wait keys on log_done). The trapped request
            // handle is deliberately NOT released (see below).
            if (*ws).log_done == (*ws).log_seq {
                if (*ws).cur_slot == 0 {
                    let status: u32 = (*ws).outcome_a.status;
                    if status == 0 {
                        status = 500;
                    };
                    append_outcome_line(ctx, &(*ws).outcome_a, status);
                } else {
                    let status: u32 = (*ws).outcome_b.status;
                    if status == 0 {
                        status = 500;
                    };
                    append_outcome_line(ctx, &(*ws).outcome_b, status);
                };
                (*ws).log_done = (*ws).log_seq + 1;
            } else {
                (*ws).trap_line_pending = true;
                (*ws).trap_seq = (*ws).log_seq;
                (*ws).trap_slot = (*ws).cur_slot;
            };
            (*ws).log_seq = (*ws).log_seq + 1;
            (*ws).in_flight = false;
            (*ws).started = 0;
            // The trapped request's handle is deliberately NOT
            // released: it belongs to a dead task's half-served
            // connection and stays out of the pool until the
            // process exits (bounded by the intensity policy).
            (*ws).req = PTR_NULL();
        };
        let now: u64 = dict_now();
        if now >= traps.window_start + TRAP_WINDOW_S {
            traps.window_start = now;
            traps.count = 0;
        };
        traps.count = traps.count + 1;
        if (*ctx).debug_sup {
            println("slanginx: worker incarnation trapped; respawning");
        };
        if traps.count > TRAP_LIMIT {
            return 3;
        };
    } else {
        if (*ctx).debug_sup {
            println("slanginx: worker incarnation completed its budget; respawning");
        };
    };
    spawn_worker(ctx, idx);
    return 0;
}

// Merged-model watchdog: a worker whose in-flight request is
// older than the reap bound is wedged (or on a transfer slower
// than the bound tolerates). The supervisor declares a
// process-level fault (exit 4): joining a wedged worker would
// stall the supervisor itself, so the process exit is the
// reap. Bounds mirror the dispatch watchdog: the aggressive
// bound applies when every worker is busy (no capacity is
// being served anyway), the routine bound otherwise.
fn merged_watchdog_scan(ctx: *ServerCtx) -> i32 {
    let now: u64 = dict_now();
    let all_busy: bool = true;
    let i: u64 = 0;
    while i < (*ctx).worker_count {
        let ws: *WorkerState = (*ctx).workers[i];
        if (*ws).active {
            if !(*ws).in_flight {
                all_busy = false;
            };
        };
        i = i + 1;
    }
    let age_limit: u64 = TRAP_REAP_MAX_S;
    if all_busy {
        age_limit = TRAP_REAP_AFTER_S;
    };
    let j: u64 = 0;
    while j < (*ctx).worker_count {
        let ws2: *WorkerState = (*ctx).workers[j];
        if (*ws2).active {
            if (*ws2).in_flight {
                if now >= (*ws2).started + age_limit {
                    println("slanginx: worker request in flight beyond the reap bound; failing loudly");
                    return 4;
                };
            };
        };
        j = j + 1;
    }
    return 0;
}

struct ExitBox {
    payload: u64,
    kind: u64,
    closed: bool,
}

// Blocking exit-report wait in 1 s slices: kind 1 = a report
// arrived, kind 3 = the slice timed out (the caller runs the
// watchdog scan). The merged supervisor's waits use ONLY the
// select shapes, like the dispatcher's (no Chan::len()).
fn select_exit(ctx: *ServerCtx, out: &ExitBox) {
    out.payload = 0;
    out.kind = 0;
    out.closed = false;
    select {
        case let (v, closed) = (*ctx).results.recv() {
            out.kind = 1;
            out.payload = v;
            out.closed = closed;
        }
        timeout(1000000000) {
            out.kind = 3;
        }
    }
}

// One supervisor generation: spawn any missing workers, then
// consume up to GEN_EVENT_BUDGET exit reports (watchdog scans
// run on the 1 s timeout slices), and return 0 so serve_merged
// starts the next generation on a fresh frame. Trap accounting
// state lives in the caller's TrapState and persists across
// generations (strictly stronger than the dispatch model,
// whose accounting resets per generation).
fn serve_merged_generation(ctx: *ServerCtx, traps: &TrapState) -> i32 {
    let i: u64 = 0;
    while i < (*ctx).worker_count {
        let ws: *WorkerState = (*ctx).workers[i];
        if !(*ws).active {
            spawn_worker(ctx, i);
        };
        i = i + 1;
    }
    let events: u64 = 0;
    while events < GEN_EVENT_BUDGET {
        let eb = ExitBox { payload: 0, kind: 0, closed: false };
        select_exit(ctx, &eb);
        if eb.closed {
            return 3;
        };
        if eb.kind == 1 {
            if eb.payload >= 4611686018427387904 {
                handle_log_record(ctx, eb.payload);
            } else {
                let rc = handle_exit_report(ctx, eb.payload, traps);
                if rc != 0 {
                    return rc;
                };
                events = events + 1;
            };
        } else {
            let rcw = merged_watchdog_scan(ctx);
            if rcw != 0 {
                return rcw;
            };
        };
    }
    return 0;
}

// Merged-model supervisor: generations back to back on fresh
// frames, forever. A generation result of 3 is the trap
// intensity breach (loud failure, same message as the dispatch
// model); 4 is the watchdog's process-level fault (its own
// message was already printed by the scan).
fn serve_merged(ctx: *ServerCtx) -> i32 {
    let traps = TrapState { count: 0, window_start: dict_now() };
    while true {
        let rc = serve_merged_generation(ctx, &traps);
        if rc == 3 {
            println("slanginx: trap intensity limit exceeded; failing loudly");
            return rc;
        };
        if rc != 0 {
            return rc;
        };
    }
    return 0;
}

fn main() -> i32 {
    // --- locate the TOML config: $SLANGINX_CONFIG or ./slanginx.toml ---
    let from_env = env_config_path();
    let cfg_buf: [u8; 512] = [0u8; 512];
    let cfg_len: u64 = 0;
    if from_env.len > 0 {
        let i: u64 = 0;
        while i < from_env.len {
            cfg_buf[i] = from_env.bytes[i];
            i = i + 1;
        }
        cfg_len = from_env.len;
    };
    if cfg_len == 0 {
        let lit: ptr = STR_PTR("slanginx.toml");
        let n: u64 = STR_LEN("slanginx.toml");
        let i: u64 = 0;
        while i < n {
            cfg_buf[i] = PTR_BYTE_AT(lit, i);
            i = i + 1;
        }
        cfg_len = n;
    };
    let cfg_ptr: ptr = PTR_BYTE_ADD(&cfg_buf, 0);
    // --- declarative layer ---
    let s = settings_blank();
    let pc = proxyconf_new();
    let dz = dictzones_new();
    let lrc: i32 = settings_load(&s, &pc, &dz, cfg_ptr, cfg_len);
    if lrc == 2 {
        println("slanginx: TOML parse error in config file");
        return 2;
    };
    if lrc == 3 {
        println("slanginx: config key has wrong type or out-of-range value");
        return 2;
    };
    if lrc == 1 {
        println("slanginx: no config file found, using built-in defaults");
    };
    // --- the access log is opened once at boot (fail fast on a
    // bad path, as the M1 probe did) and held for the process
    // lifetime (F3: no per-request open/seek/close) ---
    let log_ptr: ptr = PTR_BYTE_ADD(&s.log_path, 0);
    let sink = logsink_new();
    if access_log_open(&sink, log_ptr, s.log_len) != 0 {
        println("slanginx: cannot open access log for append");
        return 2;
    };
    // --- server up ---
    let srv: ptr = PTR_NULL();
    if sa_http_server_new_v2(&srv) != 0 {
        println("slanginx: server create failed");
        return 3;
    };
    let host_ptr: ptr = PTR_BYTE_ADD(&s.host, 0);
    if sa_http_server_start_v2(srv, host_ptr, s.host_len, s.port) != 0 {
        println("slanginx: server bind failed");
        return 3;
    };
    // Banner: static text only, via println. Calling the
    // sa_print_bytes extern directly traps CapabilityMismatch in
    // the current toolchain even with literal arguments (its
    // &msg capability contract is only satisfied through the
    // println path) -- repro registered in docs/M0_DELIVERY.md.
    // The effective listen address is the config's; the
    // acceptance harness verifies it over HTTP.
    println("slanginx: listening (address and root from config)");
    // --- stage-2 serve model: install the proxy cursor mutex,
    // build the Box-owned server context (process-lifetime,
    // deliberately never freed: connection goroutines reach it
    // by raw pointer), create the slot pool, and hand over to
    // the dispatcher (see the serve section above). ---
    let mh: u64 = 0;
    if sa_sync_mutex_new(&mh) != 0 {
        println("slanginx: cursor mutex create failed");
        return 3;
    };
    pc.cursor_mutex = mh;
    // Merged-model boot state: the results channel (worker
    // completion records + incarnation-exit reports), and the
    // serve-model selection read from the settings the
    // operator declared.
    let use_merged: bool = bytes_eq_lit(PTR_BYTE_ADD(&s.serve_model, 0), s.serve_model_len, STR_PTR("merged"), STR_LEN("merged"));
    let worker_count_v: u64 = s.workers;
    let debug_sup: bool = sa_env_has(STR_PTR("SLANGINX_DEBUG_SUPERVISOR"), STR_LEN("SLANGINX_DEBUG_SUPERVISOR")) == 0;
    let completions: Chan<u64> = Chan::new(64);
    let results: Chan<u64> = Chan::new(64);
    let slot0 = conn_slot_new(0);
    let wstate0 = worker_state_new(0);
    let ctx = Box::into_raw(Box::new(ServerCtx {
        settings: s, proxy: pc, zones: dz, sink: sink, srv: srv,
        completions: completions,
        slots: [slot0; 64],
        results: results,
        workers: [wstate0; 64],
        worker_count: worker_count_v,
        merged: use_merged,
        debug_sup: debug_sup,
    }));
    let si: u64 = 1;
    while si < CONN_SLOTS {
        (*ctx).slots[si] = conn_slot_new(si);
        (*ctx).workers[si] = worker_state_new(si);
        si = si + 1;
    }
    if use_merged {
        println("slanginx: serve model merged (workers accept directly)");
        return serve_merged(ctx);
    };
    return serve(ctx);
}
