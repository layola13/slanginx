// config: the code layer of slanginx configuration.
//
// Where settings.sla is data (TOML, edited by the operator), this
// module is a typed SLA program compiled into the server: routing
// rules and access predicates are ordinary functions, type-checked
// at build time, free to use the sa_std value layers (here: the
// ip.sla address/prefix algebra). Changing a rule here means
// recompiling -- that is the point of the layer, and the split is
// deliberate:
//
//   TOML layer (settings.sla): listen address, roots, log path.
//   Code layer (this file):     which paths are denied, which
//                               prefix is aliased to another root,
//                               which networks the ACL refuses.
//
// Live behavior driven by this layer (acceptance-verified):
//   - requests whose normalized path is "internal" or under
//     "internal/" are refused with 403, even though the files
//     exist on disk under the server root;
//   - requests under "assets/" are aliased to a different root
//     directory (config_assets_root below).
//
// The ACL predicate (config_acl_allows) is wired to live
// requests since M1: the std HTTP server face now exposes the
// peer address (sa_http_server_req_peer_addr_v2, the G2 fix),
// the accept path converts it with peer_text_to_string below
// and evaluates the predicate per request (denied -> 403 before
// routing). Unit tests still pin the predicate itself.

@import "sa_std/ip.sla"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "webpath.sla"

struct AssetsRoot {
    bytes: [u8; 128],
    len: u64,
}

// The root that "assets/" requests are aliased to (code-layer
// constant; deliberately NOT a TOML key).
fn config_assets_root() -> AssetsRoot {
    let r = AssetsRoot { bytes: [0u8; 128], len: 0 };
    let lit: ptr = STR_PTR("www-assets");
    let n: u64 = STR_LEN("www-assets");
    let i: u64 = 0;
    while i < n {
        r.bytes[i] = PTR_BYTE_AT(lit, i);
        i = i + 1;
    }
    r.len = n;
    return r;
}

// True when the normalized path is exactly "assets" or lives
// under "assets/".
fn config_route_is_assets(norm: ptr, norm_len: u64) -> bool {
    if bytes_eq_lit(norm, norm_len, STR_PTR("assets"), STR_LEN("assets")) {
        return true;
    };
    return bytes_starts_with_lit(norm, norm_len, STR_PTR("assets/"), STR_LEN("assets/"));
}

// True when the normalized path is exactly "internal" or lives
// under "internal/": the code-layer deny rule.
fn config_path_denied(norm: ptr, norm_len: u64) -> bool {
    if bytes_eq_lit(norm, norm_len, STR_PTR("internal"), STR_LEN("internal")) {
        return true;
    };
    return bytes_starts_with_lit(norm, norm_len, STR_PTR("internal/"), STR_LEN("internal/"));
}

// Build a String from raw bytes (the sa_std http_proxy.sla
// idiom: one-byte collect + format accumulation). Used to hand
// the peer address text to the String-typed ACL predicate.
fn peer_text_to_string(p: ptr, n: u64) -> String {
    let out: String = format("");
    let i: u64 = 0;
    while i < n {
        let one: [u8; 1] = [PTR_BYTE_AT(p, i)];
        let s: String = one.iter().collect<String>();
        out = format("{}{}", out, s);
        i = i + 1;
    }
    return out;
}

// One ACL table entry: is `addr` inside the prefix spelled by
// `prefix_text`? Unparseable table text denies nothing (returns
// false) -- table entries are compile-time constants below, and
// the unit tests pin their behavior.
//
// Option values are unwrapped into pre-initialized locals (the
// idiom of sa_std's own ip tests). Callers must pass format(...)
// built Strings: a bare string literal handed to a String
// parameter segfaults inside ip.sla under the current SAB test
// path (the literal/String representation split) -- repro
// registered in docs/M0_DELIVERY.md.
fn acl_entry_matches(prefix_text: String, addr: IpAddr) -> bool {
    let prefix: IpPrefix = ip_prefix_from(ip_addr_from_ipv4(0), 0);
    let ok: bool = false;
    let parsed = ip_prefix_parse(prefix_text);
    match parsed {
        Some(v) => {
            prefix = v;
            ok = true;
        },
        None => {
            ok = false;
        }
    };
    if !ok {
        return false;
    };
    return ip_prefix_contains_addr(prefix, addr);
}

// Code-layer ACL: RFC1918 private networks are refused; anything
// else parseable is allowed; unparseable input is refused.
fn config_acl_allows(ip_text: String) -> bool {
    let addr: IpAddr = ip_addr_from_ipv4(0);
    let ok: bool = false;
    let parsed = ip_addr_parse(ip_text);
    match parsed {
        Some(v) => {
            addr = v;
            ok = true;
        },
        None => {
            ok = false;
        }
    };
    if !ok {
        return false;
    };
    if acl_entry_matches(format("10.0.0.0/8"), addr) {
        return false;
    };
    if acl_entry_matches(format("172.16.0.0/12"), addr) {
        return false;
    };
    if acl_entry_matches(format("192.168.0.0/16"), addr) {
        return false;
    };
    return true;
}
