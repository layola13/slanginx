// REGRESSION (gap G5, sa_std HTTP client; fixed by the
// slanginx improvement line): a user-agent header set with
// sa_http_client_req_add_header_v2 used to never reach the
// wire -- the upstream saw std.http's own default
// ("zig/<ver> (std.http)"), because the wrapper passed every
// caller header via extra_headers, where std's overridable
// user-agent slot (emitted first, with its default) shadowed
// it. The client now routes the six slotted standard headers
// (host, authorization, user-agent, connection,
// accept-encoding, content-type) into std's header slots as
// overrides, on both the v1 and v2 send paths. This file
// originally PINNED the gap (passed while it existed); its
// assertions are now inverted into the standing regression:
// the echoed user-agent must be the caller's value and must
// not be std's default.
//
// Needs the echo fixture on 127.0.0.1:19001:
//   python3 scripts/upstream_fixture.py 19001 A
// Run from the repo root:
//   sa test docs/repro/user_agent_header_not_forwarded.sla

@import "sa_std/http_client.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

fn contains(p: ptr, n: u64, lit: ptr, lit_len: u64) -> bool {
    if n < lit_len {
        return false;
    };
    let i: u64 = 0;
    while i + lit_len <= n {
        let same: bool = true;
        let j: u64 = 0;
        while j < lit_len {
            if PTR_BYTE_AT(p, i + j) != PTR_BYTE_AT(lit, j) {
                same = false;
            };
            j = j + 1;
        }
        if same {
            return true;
        };
        i = i + 1;
    }
    return false;
}

@test "regression G5: user-agent add_header reaches the wire"() {
    let client: ptr = PTR_NULL();
    if sa_http_client_new_v2(0, STR_PTR(""), 0, &client) != 0 { panic(701); };
    let ureq: ptr = PTR_NULL();
    if sa_http_client_req_new_v2(client, 1, STR_PTR("http://127.0.0.1:19001/echo"), STR_LEN("http://127.0.0.1:19001/echo"), &ureq) != 0 { panic(702); };
    sa_http_client_req_add_header_v2(ureq, STR_PTR("user-agent"), STR_LEN("user-agent"), STR_PTR("probe-ua/1.0"), STR_LEN("probe-ua/1.0"));
    let uresp: ptr = PTR_NULL();
    let st: u32 = sa_http_client_req_send_v2(ureq, &uresp);
    if st != 0 { panic(703); };
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    if sa_http_client_resp_body_slice(uresp, &bp, &bl) != 0 { panic(704); };
    if contains(bp, bl, STR_PTR("probe-ua"), STR_LEN("probe-ua")) { } else { panic(705); };
    if contains(bp, bl, STR_PTR("zig/"), STR_LEN("zig/")) { panic(706); };
    sa_http_client_resp_free(uresp);
    sa_http_client_req_free(ureq);
    sa_http_client_free(client);
}
